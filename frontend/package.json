    "autoprefixer": "^10.6.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
